---
import { projects, site } from "../data/site";
import ProjectIllustration from "./ProjectIllustration.astro";
import "../styles/projects.css";
---

<section aria-labelledby="projects-title">
  <div class="h-px" style="background: linear-gradient(to right, transparent, #e0d9d0, transparent)"></div>
  <div class="site-content scroll-mt-24 py-20" id="projects">
    <p class="mb-3 text-[0.78rem] font-bold uppercase tracking-[0.14em] text-[#b9472d]">02 - Build</p>
    <h2 id="projects-title" class="mb-12 text-4xl font-bold text-[#1a1a1a] md:text-6xl">Build</h2>

    <div class="project-showcase">
      {projects.map((project, index) => (
        <article class:list={["showcase-card", { "showcase-card--featured": index === 0 }]}>
          <ProjectIllustration kind={project.preview} />
          <div class="showcase-copy">
            {index === 0 && <p class="showcase-kicker">Featured project</p>}
            <h3>{project.displayName ?? project.name}</h3>
            <p class="showcase-description">{project.description}</p>
            {index === 0 && <p class="showcase-tech">{project.tech.slice(0, 5).join(" · ")}</p>}
            <div class="showcase-links">
              {project.liveLink && (
                <a class="showcase-link-primary" href={project.liveLink} target="_blank" rel="noopener noreferrer">
                  Explore live site <span aria-hidden="true">↗</span>
                  <span class="sr-only"> — {project.name} (opens in a new tab)</span>
                </a>
              )}
              <a href={project.githubLink} target="_blank" rel="noopener noreferrer">
                {index === 0 ? "View code" : "Explore the project"} <span aria-hidden="true">↗</span>
                <span class="sr-only"> — {project.name} on GitHub (opens in a new tab)</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="showcase-footer">
      <p>More experiments and open-source work</p>
      <a href={site.github} target="_blank" rel="me noopener noreferrer">
        Find me on GitHub <span aria-hidden="true">↗</span>
        <span class="sr-only"> (opens in a new tab)</span>
      </a>
    </div>
  </div>
</section>
