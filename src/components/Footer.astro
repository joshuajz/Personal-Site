---
import { site } from "../data/site";
---

<footer class="bg-[#2d2d2d] px-10 py-16 text-center text-white">
  <div class="mb-1.5 text-xl font-bold">
    <span class="text-white">{site.firstName}</span> {site.lastName}
  </div>
  <div class="mb-6 flex flex-wrap justify-center gap-3 sm:gap-5">
    <a
      href={site.github}
      target="_blank"
      rel="me noreferrer"
      class="inline-flex min-h-11 items-center px-2 text-sm font-medium no-underline transition-colors hover:text-[#f4a261]"
      style="color: rgba(255,255,255,0.5)"
    >
      GitHub
    </a>
    <a
      href={site.linkedin}
      target="_blank"
      rel="me noreferrer"
      class="inline-flex min-h-11 items-center px-2 text-sm font-medium no-underline transition-colors hover:text-[#f4a261]"
      style="color: rgba(255,255,255,0.5)"
    >
      LinkedIn
    </a>
    <a
      href={`mailto:${site.email}`}
      class="inline-flex min-h-11 items-center px-2 text-sm font-medium no-underline transition-colors hover:text-[#f4a261]"
      style="color: rgba(255,255,255,0.5)"
    >
      Email
    </a>
  </div>
  <p class="text-xs" style="color: rgba(255,255,255,0.5)">
    &copy; 2026 {site.name}. All rights reserved.
  </p>
</footer>
