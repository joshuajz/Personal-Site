---
import type { BlogPost } from "../../lib/blog";
import { formatArchiveDate, getPostPath, getReadingTime } from "../../lib/blog";
import PostTitle from "./PostTitle.astro";
import { plainPostTitle } from "../../lib/post-title";

type Props = {
  posts: BlogPost[];
  headingLevel?: 2 | 3;
};

const { posts, headingLevel = 2 } = Astro.props;
---

<div class="trail-list">
  {
    posts.length > 0 ? posts.map((post) => (
      <article class="trail-row">
        <time datetime={post.data.publishedAt.toISOString()}>{formatArchiveDate(post.data.publishedAt)}</time>
        {headingLevel === 3 ? (
          <h3><a href={getPostPath(post)}><PostTitle title={post.data.title} /></a></h3>
        ) : (
          <h2><a href={getPostPath(post)}><PostTitle title={post.data.title} /></a></h2>
        )}
        <span class="trail-meta"><span>{post.data.tags.join(" / ")}</span><span class="trail-reading-time">{getReadingTime(post.body)} min</span></span>
        <a class="trail-arrow" href={getPostPath(post)} aria-label={`Read ${plainPostTitle(post.data.title)}`}>↗</a>
      </article>
    )) : <p class="blog-empty-state">No published posts yet.</p>
  }
</div>
