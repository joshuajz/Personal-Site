---
import { navigationLinks, site } from "../data/site";
import Icon from "./Icons.astro";
import "../styles/navigation.css";

const pathname = Astro.url.pathname;
const activeSectionId = pathname.startsWith("/tools")
  ? "tools"
  : pathname.startsWith("/blog")
    ? "blog"
    : "home";
const activeLabel = navigationLinks.find((link) => link.sectionId === activeSectionId)?.label ?? "Home";
---

<nav class="site-navigation-desktop" aria-label="Primary navigation">
  <a class="desktop-wordmark" href="/" aria-label={`${site.name}, home`}>
    <span>{site.firstName}</span> {site.lastName}
  </a>

  <div class="desktop-links">
    {
      navigationLinks.map((link) => {
        const isActive = link.sectionId === activeSectionId;
        return (
          <a
            href={link.href}
            data-nav-link
            data-section-id={link.sectionId}
            data-nav-label={link.label}
            aria-current={isActive ? "page" : undefined}
            class:list={["desktop-nav-link", isActive && "nav-link-active"]}
          >
            {link.label}
          </a>
        );
      })
    }
  </div>

  <span class="desktop-divider" aria-hidden="true"></span>

  <div class="desktop-socials">
    <a href={site.github} target="_blank" rel="me noreferrer" aria-label="GitHub">
      <Icon name="github" size={17} />
      <span>GitHub</span>
    </a>
    <a href={site.linkedin} target="_blank" rel="me noreferrer" aria-label="LinkedIn">
      <Icon name="linkedin" size={17} />
      <span>LinkedIn</span>
    </a>
  </div>
</nav>

<div class="site-navigation-mobile" data-mobile-navigation>
  <div class="mobile-navigation-bar">
    <a class="mobile-wordmark" href="/" aria-label={`${site.name}, home`}>
      <span>{site.firstName}</span> {site.lastName}
    </a>

    <span class="mobile-current-section" data-mobile-current>{activeLabel}</span>

    <button
      class="mobile-menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-navigation-panel"
      data-mobile-menu-toggle
    >
      <span data-mobile-menu-label>Menu</span>
      <span class="mobile-menu-toggle-icon" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>

  <button class="mobile-navigation-backdrop" type="button" aria-label="Close navigation menu" tabindex="-1" data-mobile-menu-backdrop></button>

  <nav
    id="mobile-navigation-panel"
    class="mobile-navigation-panel"
    aria-label="Mobile navigation"
    aria-hidden="true"
    inert
    data-mobile-menu-panel
  >
    <div class="mobile-panel-heading">
      <span>Navigate</span>
      <span>{site.name}</span>
    </div>

    <div class="mobile-panel-links">
      {
        navigationLinks.map((link) => {
          const isActive = link.sectionId === activeSectionId;
          return (
            <a
              href={link.href}
              data-nav-link
              data-mobile-menu-link
              data-section-id={link.sectionId}
              data-nav-label={link.label}
              aria-current={isActive ? "page" : undefined}
              class:list={["mobile-panel-link", isActive && "nav-link-active"]}
            >
              <span>{link.label}</span>
              <small class="mobile-current-indicator">Current</small>
            </a>
          );
        })
      }
    </div>

    <div class="mobile-panel-socials">
      <a href={site.github} target="_blank" rel="me noreferrer">GitHub</a>
      <a href={site.linkedin} target="_blank" rel="me noreferrer">LinkedIn</a>
      <a href={`mailto:${site.email}`}>Email</a>
    </div>
  </nav>
</div>

<script>
  const mobileNavigation = document.querySelector<HTMLElement>("[data-mobile-navigation]");

  if (mobileNavigation) {
    const toggle = mobileNavigation.querySelector<HTMLButtonElement>("[data-mobile-menu-toggle]");
    const toggleLabel = mobileNavigation.querySelector<HTMLElement>("[data-mobile-menu-label]");
    const panel = mobileNavigation.querySelector<HTMLElement>("[data-mobile-menu-panel]");
    const backdrop = mobileNavigation.querySelector<HTMLButtonElement>("[data-mobile-menu-backdrop]");
    const panelLinks = Array.from(panel?.querySelectorAll<HTMLAnchorElement>("a[href]") ?? []);
    const desktopQuery = window.matchMedia("(min-width: 768px)");

    const closeMenu = (restoreFocus = false) => {
      mobileNavigation.removeAttribute("data-open");
      toggle?.setAttribute("aria-expanded", "false");
      panel?.setAttribute("aria-hidden", "true");
      panel?.setAttribute("inert", "");
      document.documentElement.classList.remove("mobile-navigation-open");
      if (toggleLabel) toggleLabel.textContent = "Menu";
      if (restoreFocus) toggle?.focus();
    };

    const openMenu = () => {
      mobileNavigation.setAttribute("data-open", "");
      toggle?.setAttribute("aria-expanded", "true");
      panel?.setAttribute("aria-hidden", "false");
      panel?.removeAttribute("inert");
      document.documentElement.classList.add("mobile-navigation-open");
      if (toggleLabel) toggleLabel.textContent = "Close";
    };

    toggle?.addEventListener("click", () => {
      if (mobileNavigation.hasAttribute("data-open")) {
        closeMenu(true);
      } else {
        openMenu();
      }
    });

    backdrop?.addEventListener("click", () => closeMenu(true));
    panelLinks.forEach((link) => link.addEventListener("click", () => closeMenu(false)));

    document.addEventListener("keydown", (event) => {
      if (!mobileNavigation.hasAttribute("data-open")) return;

      if (event.key === "Escape") {
        closeMenu(true);
        return;
      }

      if (event.key === "Tab") {
        const focusable = [toggle, ...panelLinks].filter((element): element is HTMLElement => Boolean(element));
        const first = focusable[0];
        const last = focusable[focusable.length - 1];

        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last?.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first?.focus();
        }
      }
    });

    desktopQuery.addEventListener("change", (event) => {
      if (event.matches) closeMenu(false);
    });
  }
</script>
