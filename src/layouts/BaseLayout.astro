---
import "../styles/global.css";
import GoatCounter from "../components/GoatCounter.astro";
import { site } from "../data/site";
import type { ImageMetadata } from "astro";

type Props = {
  title?: string;
  description?: string;
  pageType?: "website" | "article";
  publishedAt?: Date;
  updatedAt?: Date;
  tags?: string[];
  socialImage?: ImageMetadata | string;
};

const title = Astro.props.title ?? `${site.name} | ${site.title}`;
const description = Astro.props.description ?? site.description;
const pageType = Astro.props.pageType ?? "website";
const publishedAt = Astro.props.publishedAt;
const updatedAt = Astro.props.updatedAt;
const tags = Astro.props.tags ?? [];
const canonicalUrl = new URL(Astro.url.pathname, site.url).toString();
const socialImageProp = Astro.props.socialImage;
const socialImagePath = typeof socialImageProp === "string" ? socialImageProp : socialImageProp?.src ?? site.socialImage;
const socialImage = new URL(socialImagePath, site.url).toString();
const socialImageWidth = typeof socialImageProp === "object" ? socialImageProp.width : 1200;
const socialImageHeight = typeof socialImageProp === "object" ? socialImageProp.height : 630;
const socialImageType = typeof socialImageProp === "object"
  ? `image/${socialImageProp.format === "jpg" ? "jpeg" : socialImageProp.format}`
  : site.socialImageType;
const pageSchema = pageType === "article"
  ? {
      "@type": "BlogPosting",
      "@id": `${canonicalUrl}#article`,
      url: canonicalUrl,
      headline: title,
      description,
      datePublished: publishedAt?.toISOString(),
      dateModified: (updatedAt ?? publishedAt)?.toISOString(),
      keywords: tags,
      image: socialImage,
      author: { "@id": `${site.url}/#person` },
      publisher: { "@id": `${site.url}/#person` },
      mainEntityOfPage: canonicalUrl,
      isPartOf: { "@id": `${site.url}/#website` },
      inLanguage: site.language,
    }
  : {
      "@type": Astro.url.pathname === "/" ? "ProfilePage" : "CollectionPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: title,
      description,
      isPartOf: { "@id": `${site.url}/#website` },
      about: { "@id": `${site.url}/#person` },
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: socialImage,
        width: socialImageWidth,
        height: socialImageHeight,
      },
      inLanguage: site.language,
    };
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${site.url}/#person`,
      name: site.name,
      givenName: site.firstName,
      familyName: site.lastName,
      url: site.url,
      image: socialImage,
      jobTitle: site.title,
      email: `mailto:${site.email}`,
      knowsAbout: ["React", "TypeScript", "JavaScript", ".NET", "Node.js", "Full-stack development"],
      sameAs: [site.github, site.linkedin],
    },
    {
      "@type": "WebSite",
      "@id": `${site.url}/#website`,
      url: site.url,
      name: `${site.name} Portfolio`,
      description,
      inLanguage: site.language,
      publisher: {
        "@id": `${site.url}/#person`,
      },
    },
    pageSchema,
  ],
};
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="me" href={site.github} />
    <link rel="me" href={site.linkedin} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} Blog`} href="/rss.xml" />
    <meta name="theme-color" content="#faf6f0" />

    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content={socialImageType} />
    <meta property="og:image:width" content={socialImageWidth.toString()} />
    <meta property="og:image:height" content={socialImageHeight.toString()} />
    <meta property="og:image:alt" content={site.socialImageAlt} />
    {pageType === "article" && publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {pageType === "article" && publishedAt && <meta property="article:modified_time" content={(updatedAt ?? publishedAt).toISOString()} />}
    {pageType === "article" && tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={site.socialImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
    <GoatCounter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>
